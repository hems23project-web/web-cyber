{
  "name": "mi-birthday-protocol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MI // BIRTHDAY PROTOCOL — an interactive memory CTF built as a birthday gift.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "lint": "tsc -b --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
